# 默认使用 DeepSeek。密钥只填在本机或部署平台的环境变量中。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 如需切回 OpenAI，将 AI_PROVIDER 改为 openai 并配置下面两项。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORT=8787

# 逗号分隔。生产环境请只保留真实前端域名。
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,https://joshshen2005.github.io

# 单个 IP 每 60 秒最多请求次数。
RATE_LIMIT_PER_MINUTE=20
